#include <iostream>
#include <iomanip>
#include <limits>
int main() {
 int hour;
 std::cout << "Enter journey hour (0-23): ";
 while (!(std::cin >> hour) || hour < 0 || hour > 23) {
 if (std::cin.fail()) {
 std::cin.clear();
 std::cin.ignore(
 std::numeric_limits<std::streamsize>::max(), '\n'
 );
 }
 std::cout << "Invalid hour. Enter 0-23: ";
 }
 long long farePaise = 3600;
 std::cout << "Journey Report\n";
 std::cout << "Hour: " << hour << '\n';
 std::cout << "Fare: Rs " << farePaise / 100 << '.'
 << std::setw(2) << std::setfill('0')
 << farePaise % 100
 << std::setfill(' ') << '\n';
 return 0;
}
