#include <iostream>
enum class Zone { Inner, Middle, Outer };
constexpr long long MIN_BALANCE_PAISE = 5000;
constexpr int PEAK_SURCHARGE_PERCENT = 20;
bool isPeak(int hour) {
 return (hour >= 8 && hour < 10) ||
 (hour >= 17 && hour < 20);
}
long long baseFare(Zone zone) {
 switch (zone) {
 case Zone::Inner:
 return 1000;
 case Zone::Middle:
 return 2000;
 case Zone::Outer:
 return 3000;
 default:
 return -1;
 }
}
long long calculateFare(Zone zone, int hour) {
 if (hour < 0 || hour > 23)
 return -1;
 long long base = baseFare(zone);
 if (base < 0)
 return -1;
 if (isPeak(hour)) {
 base += base * PEAK_SURCHARGE_PERCENT / 100;
 }
 return base;
}
bool canTravel(long long balance, long long fare) {
 return fare >= 0 &&
 balance >= fare &&
 balance - fare >= MIN_BALANCE_PAISE;
}
int main() {
 struct Test {
 Zone zone;
 int hour;
 long long balance;
 };
 Test tests[] = {
 {Zone::Inner, 11, 10000},
 {Zone::Middle, 8, 10000},
 {Zone::Outer, 10, 10000},
 {Zone::Outer, 17, 10000},
 {Zone::Inner, 20, 6000}
 };
 for (const auto& t : tests) {
 long long f = calculateFare(t.zone, t.hour);
 if (f < 0) {
 std::cout << "Invalid journey\n";
 }
 else if (canTravel(t.balance, f)) {
 std::cout << "Approved; fare paise=" << f
 << "; balance after=" << t.balance - f << '\n';
 }
 else {
 std::cout << "Denied (low balance)\n";
 }
 }
 return 0;
}
