#include <iostream>
using namespace std;

int& highestMark(int marks[], int size) {
    int index = 0;
    for (int i = 1; i < size; ++i) {
        if (marks[i] > marks[index])
            index = i;
    }
    return marks[index];
}

// Deliberately unsafe: do not call or use this function's result.
int& dangerousLocalReference() {
    int local = 50;
    return local; // returning reference to a local variable
}

int main() {
    int marks[] = {78, 91, 84, 88, 91};
    int size = sizeof(marks) / sizeof(marks[0]);

    cout << "Highest before moderation: " << highestMark(marks, size) << '\n';
    highestMark(marks, size) += 2;
    cout << "Highest after moderation: " << highestMark(marks, size) << '\n';

    cout << "Updated marks: ";
    for (int mark : marks) cout << mark << ' ';
    cout << '\n';
    return 0;
}
