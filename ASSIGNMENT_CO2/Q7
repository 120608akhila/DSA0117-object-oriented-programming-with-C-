#include <iostream>
using namespace std;

class SavingsAccountCircular {
    static const int CAPACITY = 50;
    long long accountNumber;
    double balance;
    double transactions[CAPACITY];
    int count;
    int next;

    void record(double amount) {
        transactions[next] = amount;
        next = (next + 1) % CAPACITY;
        if (count < CAPACITY) ++count;
    }

public:
    SavingsAccountCircular(long long no, double opening)
        : accountNumber(no), balance(opening), count(0), next(0) {}

    void deposit(double amount) {
        if (amount <= 0) return;
        balance += amount;
        record(amount);
    }

    bool withdraw(double amount) {
        if (amount <= 0 || amount > balance) return false;
        balance -= amount;
        record(-amount);
        return true;
    }

    void miniStatement() const {
        cout << "Account: " << accountNumber << '\n';
        cout << "Balance: " << balance << '\n';
        int start = (count == CAPACITY) ? next : 0;
        for (int i = 0; i < count; ++i)
            cout << transactions[(start + i) % CAPACITY] << '\n';
    }
};

int main() {
    SavingsAccountCircular account(20001, 1000);
    for (int i = 1; i <= 55; ++i)
        account.deposit(10 * i);
    account.miniStatement();
}
