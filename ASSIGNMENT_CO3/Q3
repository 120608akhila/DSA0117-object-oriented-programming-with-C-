#include <iostream>
class Event {
    int rows, seats;
    char** map;
public:
    Event(int r, int s) : rows(r > 0 ? r : 0), seats(s > 0 ? s : 0), map(nullptr) {
        if (rows > 0 && seats > 0) {
            map = new char*[rows];
            int made = 0;
            try {
                for (; made < rows; ++made) {
                    map[made] = new char[seats];
                    for (int j = 0; j < seats; ++j) map[made][j] = 'O';
                }
            } catch (...) {
                while (made > 0) delete[] map[--made];
                delete[] map; map = nullptr; throw;
            }
        }
        std::cout << "Event opened (" << rows << " x " << seats << ")\n";
    }
    bool book(int r, int s) {
        if (!map || r < 0 || r >= rows || s < 0 || s >= seats || map[r][s] == 'X') return false;
        map[r][s] = 'X'; return true;
    }
    bool cancel(int r, int s) {
        if (!map || r < 0 || r >= rows || s < 0 || s >= seats || map[r][s] == 'O') return false;
        map[r][s] = 'O'; return true;
    }
    void print() const {
        for (int i=0; i<rows; ++i) {
            for (int j=0; j<seats; ++j) std::cout << map[i][j] << ' ';
            std::cout << '\n';
        }
    }
    ~Event() {
        if (map) { for (int i=0; i<rows; ++i) delete[] map[i]; delete[] map; }
        std::cout << "Event closed; seat map released\n";
    }
};
int main() {
    Event local(2, 3);
    local.book(0, 1); local.print();
    {
        Event block(1, 2);
        block.book(0, 0); block.print();
    }
    Event* heap = new Event(2, 2);
    heap->book(1, 1); heap->print();
    delete heap;
    Event empty(0, 5);
}
