#include <iostream>
#include <string>
class Book {
    std::string title;
    std::string author;
    int copies;
public:
    Book() : Book("Untitled", "Unknown", 0) {}
    explicit Book(const std::string& t) : Book(t, "Unknown", 0) {}
    Book(const std::string& t, const std::string& a, int c)
        : title(t), author(a), copies(c < 0 ? 0 : c) {}
    void print() const {
        std::cout << "Title: " << title << ", Author: " << author
                  << ", Copies: " << copies << '\n';
    }
};
int main() {
    Book empty;
    Book donated("The Alchemist");
    Book complete("Wings of Fire", "A. P. J. Abdul Kalam", 5);
    Book invalid("Invalid Record", "Unknown", -3);
    empty.print(); donated.print(); complete.print(); invalid.print();
}
